<Window x:Class="RockCore.Wpf.DataSourceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据源管理" Height="420" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="BoreholeTitle" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="　每个导入批次对应一组完整性分段；删除批次将同时删除其生成的分段。"
                       Style="{StaticResource HintText}" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="BatchGrid" Margin="0,10,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="240"/>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceType}" Width="70"/>
                <DataGridTextColumn Header="回次数" Binding="{Binding RowCount}" Width="70"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="160"/>
                <DataGridTextColumn Header="导入时间" Binding="{Binding ImportedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="删除选中批次" Style="{StaticResource DangerButton}"
                    Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="72" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
