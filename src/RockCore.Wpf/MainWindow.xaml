                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#F0F0F0" Padding="8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📷 分析可视化预览" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333"/>
                                                <TextBlock Text=" — 滚轮缩放 · 按住拖动" FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <Button x:Name="ZoomControls" Content="🔍 100%" Margin="20,0,0,0" FontSize="11" Padding="8,2"
                                                        Background="Transparent" BorderBrush="#CCC" Click="ResetZoom_Click" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" x:Name="ImageContainer" Background="#FAFAFA"
                                                MouseWheel="ImageContainer_MouseWheel"
                                                MouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                                                MouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                                                MouseMove="ImageContainer_MouseMove"
                                                MouseLeave="ImageContainer_MouseLeave"
                                                Cursor="Hand">
                                            <Grid>
                                                <TextBlock Text="选择已分析照片以查看标注结果"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#999" FontSize="14"
                                                           Visibility="{Binding AnnotatedImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='inverse'}"/>
                                                <Image x:Name="AnnotatedImageControl"
                                                       Source="{Binding AnnotatedImage}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding AnnotatedImage, Converter={StaticResource NullToVisibilityConverter}}"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       SnapsToDevicePixels="True">
                                                    <Image.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="ImageScale"/>
                                                            <TranslateTransform x:Name="ImageTranslate"/>
                                                        </TransformGroup>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 完整性分段（主要结果） -->
                                <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="完整性分段（按岩芯段对应钻孔深度）" FontWeight="Bold"
                                                  Margin="0,8,0,6" Foreground="#333"/>
                                        <DataGrid x:Name="IntegritySegmentsGrid" Grid.Row="1"
                                                 ItemsSource="{Binding IntegritySegments}"
                                                 AutoGenerateColumns="False" CanUserAddRows="False"
                                                 IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                 HeadersVisibility="Column" RowHeight="26" Background="White"
                                                 BorderBrush="#E0E0E0"
                                                 HorizontalAlignment="Stretch"
                                                 MaxHeight="400"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="深度起(m)" Binding="{Binding DepthStart, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="深度止(m)" Binding="{Binding DepthEnd, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="等级" Binding="{Binding LevelText}" Width="80"/>
                                                <DataGridTextColumn Header="段长(cm)" Binding="{Binding LengthCm, StringFormat='{}{0:F1}'}" Width="90"/>
                                                <DataGridTextColumn Header="判定依据" Binding="{Binding Basis}" Width="2*"/>
                                            </DataGrid.Columns>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#444"/>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- 结构面发育程度（同表 F.0.4 判定） -->
                                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="结构面发育程度（按岩芯段分布）" FontWeight="Bold"
                                                  Margin="0,8,0,6" Foreground="#333"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding DevelopmentSegments}"
                                                 AutoGenerateColumns="False" CanUserAddRows="False"
                                                 IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                 HeadersVisibility="Column" RowHeight="26" Background="White"
                                                 BorderBrush="#E0E0E0"
                                                 HorizontalAlignment="Stretch"
                                                 MaxHeight="380"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="深度起(m)" Binding="{Binding DepthStart, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="深度止(m)" Binding="{Binding DepthEnd, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="发育程度" Binding="{Binding Development}" Width="110"/>
                                                <DataGridTextColumn Header="段长(cm)" Binding="{Binding LengthCm, StringFormat='{}{0:F1}'}" Width="90"/>
                                                <DataGridTextColumn Header="判定依据" Binding="{Binding Basis}" Width="2*"/>
                                            </DataGrid.Columns>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#444"/>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- 分析摘要 -->
                                <Border Grid.Row="3" Background="#F5F9FF" BorderBrush="#BBDEFB" BorderThickness="1"
                                        CornerRadius="4" Padding="12" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding AnalysisDetail}" TextWrapping="Wrap"
                                              Foreground="#333" FontSize="13"/>
                                </Border>

                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab: 围岩分类（阶段五） -->
                <TabItem Header="📊 围岩分类">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0" Background="#F5F9FF" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🚀 生成/刷新当前钻孔围岩分类" Padding="12,6" Margin="0,0,12,0"
                                        Background="#1976D2" Foreground="White" BorderThickness="0"
                                        Click="ClassifyBorehole_Click"/>
                                <Button Content="📊 刷新项目统计" Padding="12,6"
                                        Background="#388E3C" Foreground="White" BorderThickness="0"
                                        Click="RefreshProjectStatistics_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 单钻孔分析段 -->
                                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="当前钻孔分析段（三段融合结果）" FontWeight="Bold" Margin="0,0,0,8" Foreground="#333"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ClassificationSegments}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column" RowHeight="26"
                                                  MaxHeight="400"
                                                  ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="深度起(m)" Binding="{Binding DepthStart, StringFormat='{}{0:F2}'}" Width="90"/>
                                                <DataGridTextColumn Header="深度止(m)" Binding="{Binding DepthEnd, StringFormat='{}{0:F2}'}" Width="90"/>
                                                <DataGridTextColumn Header="长度(m)" Binding="{Binding Length, StringFormat='{}{0:F2}'}" Width="80"/>
                                                <DataGridTextColumn Header="围岩类别" Binding="{Binding RockClassText}" Width="80"/>
                                                <DataGridTextColumn Header="完整性" Binding="{Binding IntegrityLevelText}" Width="80"/>
                                                <DataGridTextColumn Header="岩质" Binding="{Binding RockTypeText}" Width="70"/>
                                                <DataGridTextColumn Header="岩体结构" Binding="{Binding RockStructureTypeText}" Width="160"/>
                                                <DataGridTextColumn Header="地下水" Binding="{Binding GroundwaterText}" Width="90"/>
                                                <DataGridTextColumn Header="判定依据" Binding="{Binding Basis}" Width="3*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="2" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="#1565C0"
                                                   Visibility="{Binding CurrentBoreholeClassSummary, Converter={StaticResource NullToVisibilityConverter}}"
                                                   Text="{Binding CurrentBoreholeClassSummary}"/>
                                    </Grid>
                                </Border>

                                <!-- 项目统计概览 -->
                                <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                                        Visibility="{Binding ProjectStatistics.ClassStats, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="项目围岩统计" FontWeight="Bold" Margin="0,0,0,8" Foreground="#333"/>
                                        <TextBlock Grid.Row="1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#1565C0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="总的围岩初步分类：{0}">
                                                    <Binding Path="ProjectStatistics.OverallClassSummary"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="岩芯总长度：{0:F2}m，已分类：{1:F2}m，未分类：{2:F2}m">
                                                    <Binding Path="ProjectStatistics.TotalCoreLength"/>
                                                    <Binding Path="ProjectStatistics.TotalClassifiedLength"/>
                                                    <Binding Path="ProjectStatistics.TotalUnclassifiedLength"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <DataGrid Grid.Row="3" ItemsSource="{Binding ProjectStatistics.ClassStats}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column" RowHeight="26"
                                                  Margin="0,0,0,12">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="围岩类别" Binding="{Binding ClassDescription}" Width="80"/>
                                                <DataGridTextColumn Header="累计长度(m)" Binding="{Binding TotalLength, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="占比" Binding="{Binding Ratio, StringFormat='{}{0:P1}'}" Width="80"/>
                                                <DataGridTextColumn Header="涉及钻孔数" Binding="{Binding BoreholeCount}" Width="90"/>
                                                <DataGridTextColumn Header="深度分布(m)" Binding="{Binding DepthRangeText}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Grid.Row="4" Text="各钻孔围岩分类" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#333"/>
                                        <ItemsControl Grid.Row="5" ItemsSource="{Binding ProjectStatistics.BoreholeStats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}围岩分类：{1}">
                                                                <Binding Path="BoreholeNumber"/>
                                                                <Binding Path="ClassSummary"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- 薄弱段 -->
                                <Border Grid.Row="2" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                                        Background="#FFEBEE"
                                        Visibility="{Binding ProjectStatistics.WeakSections, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="⚠ IV/V 类薄弱段" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,6"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ProjectStatistics.WeakSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="#C62828" Margin="0,2">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} 深 {1:F2}-{2:F2}m 为 {3} 类，长 {4:F2}m">
                                                                <Binding Path="BoreholeNumber"/>
                                                                <Binding Path="DepthStart"/>
                                                                <Binding Path="DepthEnd"/>
                                                                <Binding Path="RockClass"/>
                                                                <Binding Path="Length"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab: 三维可视化 -->
                <TabItem Header="🌐 三维可视化">
                    <view:ThreeDimView x:Name="ThreeDimViewControl"/>
                </TabItem>

                <!-- Tab: 报告 -->
                <TabItem Header="📄 报告">
                    <Grid Background="White">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="报告生成" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                            <Button Content="生成 HTML 报告" Padding="20,10" Margin="0,8" IsEnabled="False"/>
                            <Button Content="生成 Word 报告" Padding="20,10" Margin="0,8" IsEnabled="False"/>
                            <Button Content="导出 Excel 数据" Padding="20,10" Margin="0,8" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#666" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" x:Name="AnalysisProgressBar"
                             Minimum="0" Maximum="100" Value="{Binding AnalysisProgress}"
                             Height="16" Margin="12,0" Visibility="{Binding AnalysisProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="#1976D2"/>
                <TextBlock Grid.Column="2" Text="RockCore v1.0" Foreground="#999" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
