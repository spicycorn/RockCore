<Window x:Class="RockCore.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RockCore.Wpf"
        xmlns:vm="clr-namespace:RockCore.Wpf.ViewModels"
        xmlns:view="clr-namespace:RockCore.Wpf.Views"
        mc:Ignorable="d"
        Title="RockCore 岩心围岩评价软件"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
        <local:DepthDiffConverter x:Key="DepthDiffConverter"/>
        <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar（精简：视图切换由标签页承担，分析动作在照片区工具栏/右键菜单就地提供） -->
        <Menu Grid.Row="0">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目" Click="NewProject_Click"/>
                <MenuItem Header="保存" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="导入数据表..." Click="ImportData_Click"/>
                <MenuItem Header="导入岩心照片..." Click="ImportPhotos_Click"/>
                <MenuItem Header="导出报告..." Click="ExportReport_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="新建钻孔" Click="NewBorehole_Click"/>
                <MenuItem Header="编辑项目信息" Click="EditProject_Click"/>
                <MenuItem Header="编辑钻孔信息" Click="EditBorehole_Click"/>
                <Separator/>
                <MenuItem Header="删除项目" Click="DeleteProject_Click"/>
                <MenuItem Header="删除钻孔" Click="DeleteBorehole_Click"/>
            </MenuItem>
            <MenuItem Header="设置(_S)">
                <MenuItem Header="规范设置..." Click="SpecificationSettings_Click" InputGestureText="Ctrl+Alt+S"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Project Tree -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tree Header -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="项目导航" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Button Content="刷新" HorizontalAlignment="Right" Padding="10,3" FontSize="12"
                                    Style="{StaticResource SecondaryButton}" Click="Refresh_Click"
                                    ToolTip="重新加载全部项目数据"/>
                        </Grid>
                    </Border>

                    <!-- Project Tree -->
                    <TreeView Grid.Row="1" x:Name="ProjectTree"
                              ItemsSource="{Binding Projects}"
                              SelectedItemChanged="ProjectTree_SelectedItemChanged"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                              BorderThickness="0" Padding="4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Boreholes}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="📁" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="🔹" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Number}"/>
                                            <TextBlock Text=" (" Foreground="Gray"/>
                                            <TextBlock Text="{Binding TotalDepth, StringFormat={}{0:F1}m}" Foreground="Gray"/>
                                            <TextBlock Text=")" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Tree Buttons -->
                    <StackPanel Grid.Row="2" Margin="12,10">
                        <Button Content="＋ 新建项目" Margin="0,4" Click="NewProject_Click"
                                Style="{StaticResource PrimaryButton}" Padding="8,8"/>
                        <Button Content="＋ 新建钻孔" Margin="0,4" Click="NewBorehole_Click"
                                Style="{StaticResource SecondaryButton}" Padding="8,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Right Panel: Workflow Steps + Tab Control -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工作流步骤条：选中钻孔后显示，实时反映各环节完成状态，点击跳转 -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                        Visibility="{Binding SelectedBorehole, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="WorkflowStep_Click" Tag="editor">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step1Dot" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource BorderLightBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step1Num" Text="1" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step1Label" Text="导入数据" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="—" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="WorkflowStep_Click" Tag="editor">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step2Dot" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource BorderLightBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step2Num" Text="2" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step2Label" Text="分段填写" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="—" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="WorkflowStep_Click" Tag="classify">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step3Dot" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource BorderLightBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step3Num" Text="3" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step3Label" Text="围岩分类" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="—" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="WorkflowStep_Click" Tag="3d">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step4Dot" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource BorderLightBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step4Num" Text="4" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step4Label" Text="三维可视化" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1" x:Name="MainTabControl" Padding="0" BorderThickness="0">
                <!-- Tab: 项目概览 -->
                <TabItem Header="项目概览">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="当前项目: " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedProject.Name, FallbackValue='未选择'}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Content -->
                        <Grid Grid.Row="1" Margin="20">
                            <TextBlock Text="请在左侧选择项目或创建新项目"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="Gray" FontSize="16"
                                       Visibility="{Binding SelectedProject, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>

                            <ScrollViewer Visibility="{Binding SelectedProject, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel DataContext="{Binding SelectedProject}">
                                    <!-- Project Info -->
                                    <GroupBox Header="项目信息" Margin="0,0,0,16" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="项目编号:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="4" Padding="6,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="项目名称:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="4" Padding="6,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="项目阶段:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Phase, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="4" Padding="6,4"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="洞轴线方位角:" VerticalAlignment="Center"/>
                                            <Grid Grid.Row="3" Grid.Column="1" Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBox Text="{Binding CaveAxisAzimuth, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                                             Width="120" Padding="6,4"/>
                                                    <TextBlock Text="°" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="保存项目" Style="{StaticResource SuccessButton}"
                                                        HorizontalAlignment="Right" Padding="16,6"
                                                        Click="SaveProject_Click"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <!-- Borehole Summary -->
                                    <GroupBox Header="钻孔列表" Margin="0,0,0,16" Padding="12">
                                        <ItemsControl ItemsSource="{Binding Boreholes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,4" Padding="12" CornerRadius="4"
                                                            Background="White" Cursor="Hand"
                                                            MouseLeftButtonDown="BoreholeItem_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock>
                                                                    <Run Text="孔深:"/>
                                                                    <Run Text="{Binding TotalDepth, StringFormat={}{0:F2}m}" FontWeight="SemiBold"/>
                                                                    <Run Text="  |  地下水:"/>
                                                                    <Run Text="{Binding GroundwaterDepth, StringFormat={}{0:F2}m}"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="Gray" FontSize="11">
                                                                    <Run Text="方位角:"/>
                                                                    <Run Text="{Binding Azimuth, StringFormat={}{0:F2}°}"/>
                                                                    <Run Text="  |  倾角:"/>
                                                                    <Run Text="{Binding InclinationAngle, StringFormat={}{0:F2}°}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="选择" Padding="12,4"
                                                                    Click="SelectBorehole_Click" Tag="{Binding}"
                                                                    BorderThickness="0" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab: 岩心编辑器 -->
                <TabItem Header="岩心编辑器" IsEnabled="{Binding SelectedBorehole, Converter={StaticResource NotNullToBoolConverter}}">
                    <Grid Background="White">
                        <TextBlock Text="请先在左侧选择钻孔"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontSize="16"
                                   Visibility="{Binding SelectedBorehole, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>
                        <Grid Visibility="{Binding DataContext.SelectedBorehole, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}"
                              DataContext="{Binding SelectedBorehole}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="16,10"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="钻孔: " Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,20,0"/>
                                    <TextBlock Text="孔深: " Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TotalDepth, StringFormat={}{0:F1}m}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock Text="地下水埋深: " Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding GroundwaterDepth, StringFormat={}{0:F1}m}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,20,0"/>
                                    <TextBlock Text="物理段: " Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding CorePhotos.Count}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Core Editor Content -->
                            <Grid Grid.Row="1" Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Physical segments + Info segments -->
                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="3*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Physical segments header -->
                                        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="岩心物理段" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                <TextBlock Text="（照片作为附件保留，不参与判定）" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Physical segments toolbar -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8">
                                            <Button x:Name="ImportDataButton" Content="导入数据表" Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,8,0" Click="ImportData_Click"
                                                    ToolTip="按岩心回次统计模板（一钻孔一文件）导入回次数据，自动判定完整性"/>
                                            <Button x:Name="DataSourceButton" Content="数据源管理" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,8,0" Click="DataSourceManager_Click"
                                                    ToolTip="查看/删除该钻孔的导入批次"/>
                                            <Button x:Name="ImportPhotosToolbarButton" Content="导入照片(附件)" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,8,0" Click="ImportPhotosToolbarButton_Click"
                                                    ToolTip="岩心照片作为附件保留，不参与判定"/>
                                            <Button x:Name="RefreshPhotosButton" Content="刷新" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,8,0" Click="RefreshPhotosButton_Click"/>
                                            <Button x:Name="EditPhotoButton" Content="编辑" Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,8,0" Click="EditPhotoButton_Click"/>
                                            <Button x:Name="DeletePhotoButton" Content="删除" Style="{StaticResource DangerButton}"
                                                    Click="DeletePhotoButton_Click"/>
                                        </StackPanel>

                                        <!-- Physical segments DataGrid -->
                                        <DataGrid Grid.Row="2" x:Name="CorePhotosDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserSortColumns="True"
                                                  CanUserResizeColumns="True"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  ItemsSource="{Binding CorePhotos}"
                                                  SelectionMode="Single"
                                                  MouseDoubleClick="CorePhotosDataGrid_MouseDoubleClick"
                                                  Margin="8,0,8,8">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="编辑" Click="EditPhotoButton_Click"/>
                                                    <MenuItem Header="删除" Click="DeletePhotoButton_Click"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="箱号" Binding="{Binding BoxNumber}" Width="60"/>
                                                <DataGridTextColumn Header="起点(m)" Binding="{Binding DepthStart, StringFormat=F2}" Width="90"/>
                                                <DataGridTextColumn Header="终点(m)" Binding="{Binding DepthEnd, StringFormat=F2}" Width="90"/>
                                                <DataGridTextColumn Header="长度(m)" Binding="{Binding Length, StringFormat=F2}" Width="90"/>
                                                <DataGridTextColumn Header="分析状态" Binding="{Binding AnalysisStatus}" Width="90"/>
                                                <DataGridCheckBoxColumn Header="用户修正" Binding="{Binding IsUserModified}" Width="70"/>
                                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Separator -->
                                        <Separator Grid.Row="3" Margin="8,4"/>

                                        <!-- 完整性分段 header -->
                                        <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" Padding="12,8"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="完整性分段" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="（由导入数据自动生成，可直接在表中编辑）" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <ComboBox x:Name="LevelSettingsCombo" Width="88" Height="26" VerticalAlignment="Center" Margin="0,0,6,0"
                                                              ToolTip="选择要批量设置参数的完整性等级">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Content="等级参数" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"
                                                            Click="LevelSettings_Click"/>
                                                    <Button Content="保存设置" Style="{StaticResource SuccessButton}" Padding="10,4"
                                                            Click="SaveIntegritySegments_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 统一完整性分段表：等级筛选 chips + 单表 -->
                                        <Grid Grid.Row="5" Margin="12,8,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton x:Name="ChipAll" Content="全部" GroupName="SegFilter" IsChecked="True"
                                                             Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="All"/>
                                                <RadioButton x:Name="ChipIntact" GroupName="SegFilter"
                                                             Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="Intact"/>
                                                <RadioButton x:Name="ChipRelativelyIntact" GroupName="SegFilter"
                                                             Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="RelativelyIntact"/>
                                                <RadioButton x:Name="ChipPoor" GroupName="SegFilter"
                                                             Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="Poor"/>
                                                <RadioButton x:Name="ChipRelativelyBroken" GroupName="SegFilter"
                                                             Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="RelativelyBroken"/>
                                                <RadioButton x:Name="ChipBroken" GroupName="SegFilter"
                                                             Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="Broken"/>
                                            </StackPanel>

                                            <DataGrid Grid.Row="1" x:Name="SegmentsDataGrid"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      CanUserSortColumns="True" CanUserResizeColumns="True"
                                                      IsReadOnly="False" HeadersVisibility="Column"
                                                      SelectionMode="Extended"
                                                      VirtualizingPanel.IsVirtualizing="False">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="完整性等级" Width="92" IsReadOnly="True" SortMemberPath="IntegrityLevel">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding IntegrityLevel, Converter={StaticResource IntegrityLevelBrushConverter}}"
                                                                        CornerRadius="9" Padding="8,2" Margin="4,3"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IntegrityLevel, Converter={StaticResource EnumDescriptionConverter}}"
                                                                               Foreground="White" FontSize="11"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="起点(m)" Binding="{Binding DepthStart, StringFormat=F2}" Width="70" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="终点(m)" Binding="{Binding DepthEnd, StringFormat=F2}" Width="70" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="长度(m)" Binding="{Binding Length, StringFormat=F2}" Width="65" IsReadOnly="True"/>
                                                    <DataGridComboBoxColumn Header="岩质" SelectedItemBinding="{Binding RockType, UpdateSourceTrigger=PropertyChanged}" Width="75">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:RockTypeHelper.Values}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{x:Static local:RockTypeHelper.Values}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <EventSetter Event="SelectionChanged" Handler="IntegritySegmentRockType_SelectionChanged"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                    </DataGridComboBoxColumn>
                                                    <DataGridComboBoxColumn Header="岩体结构" SelectedItemBinding="{Binding RockStructureType, UpdateSourceTrigger=PropertyChanged}" Width="140">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding AvailableRockStructureTypes}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding AvailableRockStructureTypes}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <EventSetter Event="SelectionChanged" Handler="IntegritySegmentRockStructure_SelectionChanged"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                    </DataGridComboBoxColumn>
                                                    <DataGridComboBoxColumn Header="坚硬程度" SelectedItemBinding="{Binding RockHardnessLevel, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.HardnessLevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.HardnessLevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <EventSetter Event="SelectionChanged" Handler="IntegritySegmentProperty_SelectionChanged"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                    </DataGridComboBoxColumn>
                                                    <DataGridComboBoxColumn Header="岩质均一性" SelectedItemBinding="{Binding RockHomogeneity, UpdateSourceTrigger=PropertyChanged}" Width="90">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.HomogeneityOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.HomogeneityOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <EventSetter Event="SelectionChanged" Handler="IntegritySegmentProperty_SelectionChanged"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                    </DataGridComboBoxColumn>
                                                    <DataGridComboBoxColumn Header="地下水" SelectedItemBinding="{Binding GroundwaterCondition, UpdateSourceTrigger=PropertyChanged}" Width="75">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.GroundwaterOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.GroundwaterOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <EventSetter Event="SelectionChanged" Handler="IntegritySegmentGroundwater_SelectionChanged"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                    </DataGridComboBoxColumn>
                                                    <DataGridComboBoxColumn Header="洞轴夹角" SelectedValueBinding="{Binding CaveAxisAngleLessThan30, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                        <DataGridComboBoxColumn.ElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.CaveAxisOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="DisplayMemberPath" Value="Text"/>
                                                                <Setter Property="SelectedValuePath" Value="Value"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.ElementStyle>
                                                        <DataGridComboBoxColumn.EditingElementStyle>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="ItemsSource" Value="{Binding DataContext.CaveAxisOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="DisplayMemberPath" Value="Text"/>
                                                                <Setter Property="SelectedValuePath" Value="Value"/>
                                                                <EventSetter Event="SelectionChanged" Handler="IntegritySegmentCaveAxis_SelectionChanged"/>
                                                            </Style>
                                                        </DataGridComboBoxColumn.EditingElementStyle>
                                                    </DataGridComboBoxColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Background="{StaticResource BorderLightBrush}" ResizeBehavior="PreviousAndNext"/>

                                <!-- Right: Borehole properties only -->
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <!-- Borehole properties panel -->
                                    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="钻孔编号" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4"/>

                                            <TextBlock Text="孔口高程 (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding OrificeElevation, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="0,0,0,12" Padding="6,4"/>

                                            <TextBlock Text="总孔深 (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding TotalDepth, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="0,0,0,12" Padding="6,4"/>

                                            <TextBlock Text="地下水埋深 (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding GroundwaterDepth, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="0,0,0,12" Padding="6,4"/>

                                            <TextBlock Text="方位角 (°)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Azimuth, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="0,0,0,12" Padding="6,4"/>

                                            <TextBlock Text="倾角 (°)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding InclinationAngle, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="0,0,0,12" Padding="6,4"/>

                                            <Separator Margin="0,8"/>

                                            <TextBlock Text="坐标 (X, Y, Z)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding OrificeX, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="0,0,4,0" Padding="4"/>
                                                <TextBox Grid.Column="1" Text="{Binding OrificeY, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="2,0" Padding="4"/>
                                                <TextBox Grid.Column="2" Text="{Binding OrificeZ, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Margin="4,0,0,0" Padding="4"/>
                                            </Grid>

                                            <Button Content="保存钻孔信息" Click="SaveBorehole_Click" Style="{StaticResource SuccessButton}"
                                                    Padding="12,8" Margin="0,8"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab: 图像分析结果 -->
                <TabItem Header="分析结果" Visibility="Collapsed">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：已分析照片列表 -->
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="12,10,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="已分析照片" FontWeight="Bold"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}"
                                            FontSize="11" Padding="8,3" Click="RefreshAnalysisResult_Click"
                                            ToolTip="刷新已分析照片列表"/>
                                </Grid>
                                <ListView Grid.Row="1" x:Name="AnalyzedPhotosListView"
                                          ItemsSource="{Binding AnalyzedPhotos}"
                                          SelectionChanged="AnalyzedPhotosListView_SelectionChanged"
                                          Margin="8,0,8,8">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Bd"
                                                                Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderLightBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DepthStart, StringFormat='深度: {0:F2} m'}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding AnalysisStatus}" FontSize="11" Foreground="{StaticResource SuccessBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 右侧：分析详情（纵向滚动，各表格在水平方向占满容器宽度） -->
                        <ScrollViewer Grid.Column="1" Margin="12,8"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 标注图像预览（支持缩放和拖动） -->
                                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"
                                        Height="400" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{StaticResource BorderLightBrush}" Padding="8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📷 分析可视化预览" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" — 滚轮缩放 · 按住拖动" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <Button x:Name="ZoomControls" Content="🔍 100%" Margin="20,0,0,0" FontSize="11" Padding="8,2"
                                                        Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Click="ResetZoom_Click" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" x:Name="ImageContainer" Background="{StaticResource SurfaceAltBrush}"
                                                MouseWheel="ImageContainer_MouseWheel"
                                                MouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                                                MouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                                                MouseMove="ImageContainer_MouseMove"
                                                MouseLeave="ImageContainer_MouseLeave"
                                                Cursor="Hand">
                                            <Grid>
                                                <TextBlock Text="选择已分析照片以查看标注结果"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextDisabledBrush}" FontSize="14"
                                                           Visibility="{Binding AnnotatedImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='inverse'}"/>
                                                <Image x:Name="AnnotatedImageControl"
                                                       Source="{Binding AnnotatedImage}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding AnnotatedImage, Converter={StaticResource NullToVisibilityConverter}}"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       SnapsToDevicePixels="True">
                                                    <Image.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="ImageScale"/>
                                                            <TranslateTransform x:Name="ImageTranslate"/>
                                                        </TransformGroup>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 完整性分段（主要结果） -->
                                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="完整性分段（按岩心段对应钻孔深度）" FontWeight="Bold"
                                                  Margin="0,8,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <DataGrid x:Name="IntegritySegmentsGrid" Grid.Row="1"
                                                 ItemsSource="{Binding IntegritySegments}"
                                                 AutoGenerateColumns="False" CanUserAddRows="False"
                                                 IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                 HeadersVisibility="Column" RowHeight="26" Background="White"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 HorizontalAlignment="Stretch"
                                                 MaxHeight="400"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="深度起(m)" Binding="{Binding DepthStart, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="深度止(m)" Binding="{Binding DepthEnd, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="等级" Binding="{Binding LevelText}" Width="80"/>
                                                <DataGridTextColumn Header="段长(cm)" Binding="{Binding LengthCm, StringFormat='{}{0:F1}'}" Width="90"/>
                                                <DataGridTextColumn Header="判定依据" Binding="{Binding Basis}" Width="2*"/>
                                            </DataGrid.Columns>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- 结构面发育程度（同表 F.0.4 判定） -->
                                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="结构面发育程度（按岩心段分布）" FontWeight="Bold"
                                                  Margin="0,8,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding DevelopmentSegments}"
                                                 AutoGenerateColumns="False" CanUserAddRows="False"
                                                 IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                 HeadersVisibility="Column" RowHeight="26" Background="White"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 HorizontalAlignment="Stretch"
                                                 MaxHeight="380"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="深度起(m)" Binding="{Binding DepthStart, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="深度止(m)" Binding="{Binding DepthEnd, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="发育程度" Binding="{Binding Development}" Width="110"/>
                                                <DataGridTextColumn Header="段长(cm)" Binding="{Binding LengthCm, StringFormat='{}{0:F1}'}" Width="90"/>
                                                <DataGridTextColumn Header="判定依据" Binding="{Binding Basis}" Width="2*"/>
                                            </DataGrid.Columns>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- 分析摘要 -->
                                <Border Grid.Row="3" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryLightBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="12" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding AnalysisDetail}" TextWrapping="Wrap"
                                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                </Border>

                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab: 围岩分类（阶段五） -->
                <TabItem Header="围岩分类">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="生成/刷新围岩分类" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                        Click="ClassifyBorehole_Click"/>
                                <Button Content="刷新项目统计" Style="{StaticResource SecondaryButton}"
                                        Click="RefreshProjectStatistics_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 单钻孔分析段 -->
                                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="当前钻孔分析段（三段融合结果）" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ClassificationSegments}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column" RowHeight="26"
                                                  MaxHeight="400"
                                                  ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="深度起(m)" Binding="{Binding DepthStart, StringFormat='{}{0:F2}'}" Width="90"/>
                                                <DataGridTextColumn Header="深度止(m)" Binding="{Binding DepthEnd, StringFormat='{}{0:F2}'}" Width="90"/>
                                                <DataGridTextColumn Header="长度(m)" Binding="{Binding Length, StringFormat='{}{0:F2}'}" Width="80"/>
                                                <DataGridTextColumn Header="围岩类别" Binding="{Binding RockClassText}" Width="80"/>
                                                <DataGridTextColumn Header="完整性" Binding="{Binding IntegrityLevelText}" Width="80"/>
                                                <DataGridTextColumn Header="岩质" Binding="{Binding RockTypeText}" Width="70"/>
                                                <DataGridTextColumn Header="岩体结构" Binding="{Binding RockStructureTypeText}" Width="160"/>
                                                <DataGridTextColumn Header="地下水" Binding="{Binding GroundwaterText}" Width="90"/>
                                                <DataGridTextColumn Header="判定依据" Binding="{Binding Basis}" Width="3*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="2" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{StaticResource PrimaryBrush}"
                                                   Visibility="{Binding CurrentBoreholeClassSummary, Converter={StaticResource NullToVisibilityConverter}}"
                                                   Text="{Binding CurrentBoreholeClassSummary}"/>
                                    </Grid>
                                </Border>

                                <!-- 项目统计概览 -->
                                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                                        Visibility="{Binding ProjectStatistics.ClassStats, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="项目围岩统计" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="围岩初步分类（按钻孔总深度）：{0}">
                                                        <Binding Path="ProjectStatistics.OverallClassSummary"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="围岩初步分类（按已分析长度）：{0}">
                                                        <Binding Path="ProjectStatistics.OverallClassSummaryByAnalyzed"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="岩心总长度：{0:F2}m，已分类：{1:F2}m，未分类：{2:F2}m">
                                                    <Binding Path="ProjectStatistics.TotalCoreLength"/>
                                                    <Binding Path="ProjectStatistics.TotalClassifiedLength"/>
                                                    <Binding Path="ProjectStatistics.TotalUnclassifiedLength"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <DataGrid Grid.Row="3" ItemsSource="{Binding ProjectStatistics.ClassStats}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column" RowHeight="26"
                                                  Margin="0,0,0,12">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="围岩类别" Binding="{Binding ClassDescription}" Width="80"/>
                                                <DataGridTextColumn Header="累计长度(m)" Binding="{Binding TotalLength, StringFormat='{}{0:F2}'}" Width="100"/>
                                                <DataGridTextColumn Header="占比(按总深度)" Binding="{Binding Ratio, StringFormat='{}{0:P1}'}" Width="100"/>
                                                <DataGridTextColumn Header="占比(按分析长)" Binding="{Binding RatioByAnalyzed, StringFormat='{}{0:P1}'}" Width="100"/>
                                                <DataGridTextColumn Header="涉及钻孔数" Binding="{Binding BoreholeCount}" Width="90"/>
                                                <DataGridTextColumn Header="深度分布(m)" Binding="{Binding DepthRangeText}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Grid.Row="4" Text="各钻孔围岩分类" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <ItemsControl Grid.Row="5" ItemsSource="{Binding ProjectStatistics.BoreholeStats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}围岩分类（按总深度）：{1}">
                                                                    <Binding Path="BoreholeNumber"/>
                                                                    <Binding Path="ClassSummary"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}围岩分类（按分析长）：{1}">
                                                                    <Binding Path="BoreholeNumber"/>
                                                                    <Binding Path="ClassSummaryByAnalyzed"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- 薄弱段 -->
                                <Border Grid.Row="2" BorderBrush="{StaticResource DangerBgBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                                        Background="{StaticResource DangerBgBrush}"
                                        Visibility="{Binding ProjectStatistics.WeakSections, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="⚠ IV/V 类薄弱段" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ProjectStatistics.WeakSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="{StaticResource DangerBrush}" Margin="0,2">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} 深 {1:F2}-{2:F2}m 为 {3} 类，长 {4:F2}m">
                                                                <Binding Path="BoreholeNumber"/>
                                                                <Binding Path="DepthStart"/>
                                                                <Binding Path="DepthEnd"/>
                                                                <Binding Path="RockClass"/>
                                                                <Binding Path="Length"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab: 三维可视化 -->
                <TabItem Header="三维可视化">
                    <view:ThreeDimView x:Name="ThreeDimViewControl"/>
                </TabItem>

                <!-- Tab: 报告 -->
                <TabItem Header="报告">
                    <Grid Background="White">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="报告生成" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                            <Button Content="生成 HTML 报告" Padding="20,10" Margin="0,8" IsEnabled="False"/>
                            <Button Content="生成 Word 报告" Padding="20,10" Margin="0,8" IsEnabled="False"/>
                            <Button Content="导出 Excel 数据" Padding="20,10" Margin="0,8" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                <ProgressBar Grid.Column="1" x:Name="AnalysisProgressBar"
                             Minimum="0" Maximum="100" Value="{Binding AnalysisProgress}"
                             Height="6" Margin="12,0" VerticalAlignment="Center"
                             Visibility="{Binding AnalysisProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"
                             Background="{StaticResource BorderLightBrush}"/>
                <TextBlock Grid.Column="2" x:Name="VersionTextBlock" Text="RockCore" Foreground="{StaticResource TextDisabledBrush}"
                           VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
