<Window x:Class="RockCore.Wpf.SegmentSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RockCore.Wpf"
        Title="分段设置参数" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <Window.Resources>
        <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="深度区间 (m)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="DepthStartTxt" Padding="8,6" Text="0.00"/>
            <TextBlock Grid.Column="1" Text="~" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" x:Name="DepthEndTxt" Padding="8,6" Text="0.00"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="岩质类型" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3" x:Name="RockTypeCombo" Padding="8,6" Margin="0,0,0,10"
                  SelectionChanged="RockTypeCombo_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="岩体结构类型" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="5" x:Name="RockStructureCombo" Padding="8,6" Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="6" Text="坚硬程度" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="7" x:Name="HardnessCombo" Padding="8,6" Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="8" Text="岩质均一性" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="9" x:Name="HomogeneityCombo" Padding="8,6" Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Row="10" Orientation="Vertical">
            <TextBlock Text="地下水条件" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="GroundwaterCombo" Padding="8,6" Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="洞轴线与岩层走向夹角" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="CaveAxisCombo" Padding="8,6" Margin="0,0,0,10">
                <ComboBoxItem Content="不设置"/>
                <ComboBoxItem Content="小于30°"/>
                <ComboBoxItem Content="大于等于30°"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Width="80" Padding="8,6" Margin="0,0,8,0"
                    Click="OK_Click" IsDefault="True"/>
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="80" Padding="8,6"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
