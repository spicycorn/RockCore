<Window x:Class="RockCore.Wpf.CorePhotoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑物理段"
        Height="440" Width="560"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="文件名" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="FileNameTextBox" Margin="0,0,0,12" Padding="6,4" IsReadOnly="True"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="箱号" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="BoxNumberTextBox" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                    <TextBlock Text="深度起点 (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="DepthStartTextBox" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                    <TextBlock Text="深度终点 (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="DepthEndTextBox" Padding="6,4"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox x:Name="RemarksTextBox" Padding="6,4" Height="80" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <CheckBox x:Name="MarkUserModifiedCheckBox"
                      Content="标记为用户手动修正（后续重新分析时不覆盖）"
                      Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Padding="18,6" Margin="6,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="保存" Padding="18,6" Margin="6,0"
                    Background="#2196F3" Foreground="White" BorderThickness="0"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
