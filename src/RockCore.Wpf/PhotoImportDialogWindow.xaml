<Window x:Class="RockCore.Wpf.PhotoImportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入岩芯照片"
        Height="600" Width="900"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="照片目录：" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="DirectoryPathTextBox" MinWidth="400" VerticalAlignment="Center" IsReadOnly="True"/>
            <Button x:Name="BrowseButton" Content="浏览..." Margin="6,0" Padding="10,4" Click="BrowseButton_Click"/>
            <Button x:Name="ScanButton" Content="扫描并解析" Margin="6,0" Padding="10,4" Click="ScanButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="SummaryTextBlock" Margin="0,8,0,8" Foreground="#555"/>

        <DataGrid Grid.Row="2" x:Name="PhotosDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  AlternatingRowBackground="#FAFAFA">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="导入" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="箱号" Binding="{Binding BoxNumber, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="起点(m)" Binding="{Binding DepthStart, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="90"/>
                <DataGridTextColumn Header="终点(m)" Binding="{Binding DepthEnd, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="90"/>
                <DataGridTextColumn Header="长度(m)" Binding="{Binding Length, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="警告" Binding="{Binding Warning, Mode=OneWay}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
            <CheckBox x:Name="ReplaceExistingCheckBox" Content="覆盖该钻孔已有的物理段（删除并重新导入）" IsChecked="False"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="取消" Padding="18,6" Margin="6,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="ImportButton" Content="确认导入" Padding="18,6" Margin="6,0" Background="#2196F3" Foreground="White" BorderThickness="0" Click="ImportButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
